    return ListView.builder(
      padding: EdgeInsets.all(16),
      itemCount: pendingTasks.length,
      itemBuilder: (context, index) {
        final task = pendingTasks[index];
        return TaskCard(task: task, isPending: true, key: ValueKey(task.ids));
