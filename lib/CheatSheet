// STEP 1: Repository instance is created FIRST (somewhere else)
final repository = TaskRepository(); // ← Instance EXISTS here

// STEP 2: TaskNotifier is created and repository is PASSED IN
final notifier = TaskNotifier(repository);

// STEP 3: Inside TaskNotifier constructor
TaskNotifier(this._repository) {  // ← _repository NOW references the instance
  loadTasks();  // ← Can use _repository because it's already assigned
}

// STEP 4: loadTasks() can use _repository
Future<void> loadTasks() async {
  final tasks = await _repository.fetchAllTasks(); // ← Works! Instance exists!
}


