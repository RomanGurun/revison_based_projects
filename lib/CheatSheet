class Task {
  String id;
  String title;
  Task({required this.id, required this.title});
}

List<Task> _tasks = [
  Task(id: '1', title: 'Original'),
];

List<Task> copy = List.from(_tasks);

// ⚠️ The list is copied, but Task objects are still shared!
copy[0].title = 'Modified';

print(_tasks[0].title);  // "Modified" - object is shared!
print(copy[0].title);    // "Modified"

// But you can't affect the list structure:
copy.clear();  // Only clears the copy
print(_tasks.length);  // Still 1 ✅

// Method 1: List.from()
List<Task> copy1 = List.from(_tasks);

// Method 2: Spread operator (...)
List<Task> copy2 = [..._tasks];

// Method 3: .toList()
List<Task> copy3 = _tasks.toList();

// Method 4: List.of()
List<Task> copy4 = List.of(_tasks);

// All create shallow copies!

