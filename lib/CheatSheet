// My Notes: where vs indexWhere

// where() - returns matching items
final matchingTasks = tasks.where((t) => t.id == 2); // Returns Iterable<Task>

// indexWhere() - returns position number
final position = tasks.indexWhere((t) => t.id == 2); // Returns int (0,1,2... or -1)

// Remember: indexWhere gives INDEX (position), not true/false!



